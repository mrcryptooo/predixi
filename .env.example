# ─────────────────────────────────────────────────────────────────────────────
# PrediXI — environment variable reference
# Copy to .env.local and fill in real values. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# Create a project at supabase.com, then find these in Settings → API.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER ONLY, no NEXT_PUBLIC_ prefix.
# Never use in client components. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Admin secrets — SERVER ONLY
# Set strong random values. Used to authenticate admin API routes.
# x-admin-key header must match ADMIN_SETTLEMENT_KEY.
# Legacy alias kept for backward-compat routes that still check SETTLEMENT_ADMIN_SECRET.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SETTLEMENT_KEY=
SETTLEMENT_ADMIN_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Cron secret — SERVER ONLY
# Set in Vercel dashboard → Settings → Environment Variables.
# Vercel automatically passes this as Authorization: Bearer <CRON_SECRET>.
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Football data APIs — SERVER ONLY, never prefix with NEXT_PUBLIC_
# At least one key is required for fixture sync cron to do anything.
# football-data.org: https://www.football-data.org/client/login
# api-football (api-sports.io): https://dashboard.api-football.com
# ─────────────────────────────────────────────────────────────────────────────
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Base Builder Code (ERC-8021 attribution)
# Obtain from base.dev after domain verification.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_BUILDER_CODE=

# ─────────────────────────────────────────────────────────────────────────────
# WalletConnect (optional — enables WalletConnect QR code wallet selector)
# Obtain from cloud.reown.com (free tier). If unset, WalletConnect option
# is hidden from the wallet selector — other wallets still work.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WC_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Site URL — canonical production URL used in metadata, OG tags, referral
# links, and Farcaster manifest. Defaults to https://predixi.xyz if unset.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://predixi.xyz

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis (optional — enables server-side rate limiting)
# Obtain from console.upstash.com. If unset, rate limiting is disabled.
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Vercel token (optional — only needed for CLI deploys / CI pipelines)
# https://vercel.com/account/tokens
# ─────────────────────────────────────────────────────────────────────────────
VERCEL_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Local proxy (optional — only needed on machines that require a proxy)
# Node.js fetch (undici) does not auto-detect Windows system proxy settings.
# Leave blank or omit on machines without a proxy requirement.
# ─────────────────────────────────────────────────────────────────────────────
# HTTPS_PROXY=http://127.0.0.1:2080
